AUTH_DOMAINS=glowgrace.com,www.glowgrace.com
CLIENT_ID=your_oauth_client_id
ISSUER_URL=https://auth.glowgrace.com/oidc

SESSION_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgres://user:password@host:5432/database

MONGODB_URI=mongodb://localhost:27017/glowgrace

STRIPE_SECRET_KEY=sk_test_...

NODE_ENV=production
PORT=5000

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-side Firebase ID token verification (defaults to VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=your_project_id
# Development only: accept the client's demo sign-ins that have no Firebase ID token
ALLOW_UNVERIFIED_FIREBASE_SYNC=true

# Comma-separated emails that can use /api/admin/* (verify UPI payments, update orders)
ADMIN_EMAILS=owner@glowgrace.com
# Your UPI VPA, used to build "Open UPI app" payment links
UPI_ID=glowgrace@upi
# Minutes an unpaid UPI order holds stock before it is released
UNPAID_ORDER_TTL_MINUTES=30
